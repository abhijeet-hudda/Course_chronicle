# Render supplies PORT automatically. Leave it unset in production.
# Locally, you may use PORT=8000.
PORT=8000
NODE_ENV=development

# Use the MongoDB cluster URI only. Do not add a database name at the end:
# the server appends Course_chronicle_project itself.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net

# Create a long, random value; do not reuse this sample value.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRY=1d
COOKIE_MAX_AGE_MS=86400000

# Comma-separated allowed browser origins; no trailing slash.
CORS_ORIGIN=http://localhost:5173

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

GEMINI_KEY=your_gemini_api_key

RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
